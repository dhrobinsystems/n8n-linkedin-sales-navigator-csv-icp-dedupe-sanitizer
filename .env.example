# n8n-linkedin-sales-navigator-csv-icp-dedupe-sanitizer
# Copy to .env for local runs, or set these on your n8n host.
# Every value is a safe placeholder. Never commit a real .env file.

# ---------------------------------------------------------------
# Safety switches (keep both true until you have reviewed a run)
# ---------------------------------------------------------------
# DRY_RUN=true      local CLI prints a preview and writes no files.
# SANDBOX_MODE=true HubSpot checks use the synthetic fixture snapshot, no network access.
DRY_RUN=true
SANDBOX_MODE=true

# ---------------------------------------------------------------
# Rules
# ---------------------------------------------------------------
# Maximum contacts kept per root domain. Extra rows go to quarantine_dropped.csv.
MAX_CONTACTS_PER_ACCOUNT=3
# Set true to drop rows without a valid email (Sales Navigator exports usually have none).
REQUIRE_EMAIL=false
# Optional tag added as a column in sequencer_ready.csv.
CAMPAIGN_TAG=zzz_TEST_CAMP_01

# ---------------------------------------------------------------
# HubSpot (read-only, used only when SANDBOX_MODE=false)
# ---------------------------------------------------------------
# Private app scopes needed: crm.objects.companies.read, crm.objects.deals.read
HUBSPOT_ACCESS_TOKEN=replace_with_your_hubspot_private_app_token
# Company property that marks do-not-contact. Leave empty to disable the check.
HUBSPOT_DNC_PROPERTY=do_not_contact
# Deal stage IDs treated as closed lost (comma separated). Any other stage suppresses the account.
HUBSPOT_CLOSED_LOST_STAGES=closedlost
HUBSPOT_MAX_RETRIES=4
HUBSPOT_MIN_INTERVAL_MS=220

# ---------------------------------------------------------------
# File locations for the local CLI
# ---------------------------------------------------------------
ICP_RULES_PATH=config/icp-rules.example.json
SUPPRESSION_DOMAINS_PATH=config/suppression-domains.example.json
HUBSPOT_SNAPSHOT_PATH=fixtures/hubspot_crm_snapshot.sample.json
INPUT_CSV_PATH=fixtures/sales_nav_export.sample.csv
OUTPUT_DIR=output

# ---------------------------------------------------------------
# n8n only
# ---------------------------------------------------------------
# Required for the Webhook Trigger. Callers must send it in the x-webhook-secret header.
WEBHOOK_SHARED_SECRET=replace_with_a_long_random_string
# Optional overrides for the bundled defaults (JSON on one line, or a comma separated list).
# ICP_RULES_JSON=
# SUPPRESSION_DOMAINS=suppressed-client.example,do-not-mail.example
# HUBSPOT_SNAPSHOT_JSON=
